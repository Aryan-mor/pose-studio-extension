{
  "manifest_version": 3,
  "name": "Pose Studio for AI Chats",
  "version": "3.1.0",
  "description": "Pick a portrait, costume and pose, then send them with a ready-made prompt straight into Gemini, ChatGPT or Grok.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Pose Studio",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.oaiusercontent.com/*",
    "https://ai-pose-gallery.pages.dev/*",
    "https://ai-costume-gallery.pages.dev/*",
    "https://ai-portrait-gallery.pages.dev/*",
    "https://grok.com/*",
    "https://*.grok.com/*",
    "https://*.x.ai/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://grok.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/*",
        "thumbs/*"
      ],
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://grok.com/*"
      ]
    }
  ]
}